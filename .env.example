# Database (Postgres for prod; sqlite only for local dev)
DATABASE_URL=postgresql+asyncpg://hydenlyne:hydenlyne_pass@db:5432/hydenlyne
POSTGRES_USER=hydenlyne
POSTGRES_PASSWORD=hydenlyne_pass
POSTGRES_DB=hydenlyne

# Redis (password required in production — set a strong random value)
REDIS_URL=redis://:dev_redis_pass@redis:6379/0
REDIS_PASSWORD=dev_redis_pass

# Ollama (runs as a compose service; point OLLAMA_MODELS_PATH at an existing
# model store to avoid re-downloading multi-GB models)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODELS_PATH=${HOME}/.ollama/models

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Meilisearch
MEILI_HOST=meilisearch
MEILI_PORT=7700
MEILI_MASTER_KEY=set_a_long_random_value_for_prod

# Sentry (error tracking - leave empty to disable)
SENTRY_DSN=

# Auth - REQUIRED, must be >= 32 chars and non-default in production
SESSION_SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars
SESSION_COOKIE_NAME=hydenlyne_session

# Bootstrap admin user (created on first startup; password only set if missing)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# App
APP_ENV=development
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
LOG_LEVEL=INFO
DOCUMENT_STORAGE_PATH=/app/data/documents

# Flower (Celery monitoring) — rotate from default in production
FLOWER_USER=admin
FLOWER_PASSWORD=flower_pass

# API Key for agent-to-backend communication (agents use X-API-Key header)
API_KEY=

# Dropbox (fill in when integrating)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Preferred: run `python backend/dropbox_authorize.py` once to obtain this.
# It does not expire, and the backend mints access tokens from it on demand.
DROPBOX_REFRESH_TOKEN=
# Legacy fallback. Console-generated `sl.` tokens expire after ~4 hours and
# must be replaced by hand; leave blank when a refresh token is set.
DROPBOX_ACCESS_TOKEN=
DROPBOX_WEBHOOK_SECRET=