# GraphQL endpoint the FE talks to. Set to the deployed backend URL for prod,
# and pass via build ARG (VITE_GRAPHQL_URL) in the Docker multi-stage build.
VITE_GRAPHQL_URL=http://localhost:8000/graphql

# Demo mode: true shows fabricated demo consultants when backend is empty/offline
# (dev/showcase only). Production builds default to false — never ship fake crew.
VITE_ENABLE_DEMO_MODE=true

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY (optional): Required only if using Gemini AI overview feature.
GEMINI_API_KEY="MY_GEMINI_API_KEY"